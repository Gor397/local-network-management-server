# Generate real secrets with scripts/bootstrap.sh; never deploy this example verbatim.
POSTGRES_USER=lantern
POSTGRES_DB=lantern
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
DATABASE_URL=postgresql+psycopg://lantern:REPLACE_WITH_GENERATED_SECRET@db/lantern
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
DATA_DIR=/data
PUBLIC_ORIGIN=https://192.168.88.10
TRUSTED_HOSTS=192.168.88.10,localhost,127.0.0.1
LAN_BIND_IP=192.168.88.10
HTTPS_PORT=443
COOKIE_SECURE=true
LOW_RESOURCE_MODE=true
# Safety mode, enforced by the server for every route and background job:
# read_only | dry_run | controlled_test | production. Start with read_only.
OPERATION_MODE=read_only
# controlled_test only: comma-separated router IDs/names/management IPs and device IDs/hostnames.
TEST_ROUTERS=
TEST_DEVICES=
# Unencrypted RouterOS API (port 8728) for routers without an API-SSL certificate. The password
# crosses the LAN in clear text and such routers are always read-only in Suro.
ROUTER_PLAINTEXT_API_ALLOWED=false
# Legacy switch; ignored when OPERATION_MODE is set.
ROUTER_WRITES_ENABLED=false
DEPLOYMENT_ENABLED=false
SSH_ENABLED=false
HEARTBEAT_DEADLINE_SECONDS=300
EVIDENCE_TTL_SECONDS=300
DEPLOYMENT_CONCURRENCY=2
TRANSFER_BYTES_PER_SECOND=2097152
HEALTH_RETENTION_DAYS=7
# Exact isolated management subnet(s) only. Never include the internet-connected LAN.
ROUTER_ALLOWED_NETWORKS=192.168.88.0/24
SSH_ALLOWED_NETWORKS=192.168.88.0/24
LANTERN_TAG=0.1.0
DB_MEMORY=256m
BACKEND_MEMORY=384m
WORKER_MEMORY=192m
WEB_MEMORY=64m
DB_CPUS=0.50
BACKEND_CPUS=0.75
WORKER_CPUS=0.35
WEB_CPUS=0.25

# Optional administrator MFA; agent certificates and RouterOS TLS remain mandatory.
MFA_REQUIRED=false
MFA_LOGIN_REQUIRED=false
RECOVERY_ENABLED=false
NETWORK_POLL_CONCURRENCY=2
NETWORK_HEALTH_SECONDS=60
NETWORK_INVENTORY_SECONDS=900
TELEMETRY_RETENTION_DAYS=7
# Shared API-process transfer limits; production starts one API worker.
TRANSFER_GLOBAL_BYTES_PER_SECOND=2097152
TRANSFER_CONCURRENCY=2
UPLOAD_RETENTION_DAYS=7
